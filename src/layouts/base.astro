---
import BaseHead from '../components/BaseHead.astro'
import SiteFooter from '../components/site-footer.astro'
import Header from '../components/Header.astro'
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts'

const { title, description } = Astro.props
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={title ?? SITE_TITLE}
			description={description ?? SITE_DESCRIPTION}
		/>
	</head>
	<body class="bg-muted text-foreground font-pixel-square antialiased">
		<div class="m-auto flex min-h-screen max-w-6xl flex-col">
			<Header />
			<div class="flex flex-1 flex-col px-5 py-5 md:py-12">
				<main class="pb-12">
					<slot />
				</main>
			</div>
			<SiteFooter />
		</div>
	</body>
</html>
