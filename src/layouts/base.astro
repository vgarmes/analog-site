---
import BaseHead from '../components/BaseHead.astro'
import SiteFooter from '../components/site-footer.astro'
import Header from '../components/Header.astro'
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts'

const { title, description } = Astro.props
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={title ?? SITE_TITLE}
			description={description ?? SITE_DESCRIPTION}
		/>
	</head>
	<body
		class="bg-background text-foreground font-pixel-square flex min-h-screen flex-col antialiased"
	>
		<Header />
		<main class="mx-auto flex w-full max-w-6xl flex-1 flex-col p-5 md:py-12">
			<slot />
		</main>
		<SiteFooter />
	</body>
</html>
