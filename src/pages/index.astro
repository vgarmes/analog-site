---
import { getCollection } from 'astro:content'
import FormattedDate from '../components/FormattedDate.astro'
import RyuSprite from '../components/RyuSprite.astro'
import BaseLayout from '../layouts/base.astro'
import VmuDisplay from '../components/VmuDisplay.astro'

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
)
---

<BaseLayout>
	<div class="flex items-center gap-6">
		<div>
			<h1 class="font-pixel-grid pb-3 text-4xl lg:text-8xl">Analog Freak</h1>
			<h2 class="text-muted-foreground text-xl">
				Webzine about retro gaming and analog tech
			</h2>
		</div>
		<RyuSprite class="ml-auto" />
	</div>

	<div class="mt-16 flex gap-5 sm:mt-32">
		<section class="bg-card flex-1 space-y-5 border sm:space-y-6">
			<h3 class="font-medium">Writing</h3>
			<ul class="flex flex-col gap-7 sm:gap-4">
				{
					posts.map(post => (
						<li>
							<a
								href={`/blog/${post.id}/`}
								class="-mx-3 flex gap-1 rounded-md px-3 hover:bg-[#F5F4F4] sm:py-3 md:grid md:grid-cols-[1fr_100px] md:gap-4 dark:hover:bg-gray-200"
							>
								<div class="flex flex-col">
									<span>{post.data.title}</span>
									<span class="text-muted-foreground">
										{post.data.description}
									</span>
								</div>

								<FormattedDate
									date={post.data.pubDate}
									class="text-muted-foreground hidden text-right text-sm leading-6 md:block"
								/>
							</a>
						</li>
					))
				}
			</ul>
		</section>
		<section class="flex flex-col border p-3">
			<VmuDisplay dot={5} />
		</section>
	</div>
</BaseLayout>
