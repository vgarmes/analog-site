---
import { getCollection } from 'astro:content'
import FormattedDate from '../components/FormattedDate.astro'
import BaseLayout from '../layouts/base.astro'
import VmuDisplay from '../components/VmuDisplay.astro'
import Card from '../components/ui/card/card.astro'
import CardHeader from '../components/ui/card/card-header.astro'
import CardTitle from '../components/ui/card/card-title.astro'
import CardContent from '../components/ui/card/card-content.astro'
import CardFooter from '../components/ui/card/card-footer.astro'
import ArrowRight from '../components/icons/arrow-right.astro'

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
)
---

<BaseLayout>
	<img
		src="/ascii-clouds.webp"
		alt="ASCII art clouds"
		width="3024"
		height="1579"
		class="ring-foreground/10 mb-5 block h-auto max-h-[240px] w-full object-cover ring-1"
	/>
	<div class="grid grid-cols-1 items-start gap-5 md:grid-cols-3">
		<Card class="md:col-span-2">
			<CardHeader>
				<CardTitle>Writing</CardTitle>
			</CardHeader>

			<div class="space-y-5 sm:space-y-6">
				<ul class="divide-border flex flex-col divide-y">
					{
						posts.map(post => (
							<li>
								<a
									href={`/blog/${post.id}/`}
									class="hover:bg-muted flex gap-1 p-3 md:grid md:grid-cols-[1fr_100px] md:gap-4"
								>
									<div class="flex flex-col">
										<span>{post.data.title}</span>
										<span class="text-muted-foreground">
											{post.data.description}
										</span>
									</div>

									<FormattedDate
										date={post.data.pubDate}
										class="text-muted-foreground hidden text-right text-xs leading-6 md:block"
									/>
								</a>
							</li>
						))
					}
				</ul>
			</div>
			<CardFooter>
				<a
					class="before:text-muted-foreground after:text-muted-foreground hover:bg-primary hover:text-primary-foreground hover:before:text-primary-foreground hover:after:text-primary-foreground ml-auto inline-flex cursor-pointer items-center gap-1 text-xs uppercase before:mr-1.5 before:content-['['] after:ml-1.5 after:content-[']']"
				>
					All posts →
				</a>
			</CardFooter>
		</Card>
		<Card>
			<CardHeader>
				<CardTitle>Visual Memory Unit</CardTitle>
			</CardHeader>
			<CardContent class="flex flex-col items-center p-3">
				<VmuDisplay />
			</CardContent>
		</Card>
	</div>
</BaseLayout>
