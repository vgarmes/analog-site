---
import { getCollection } from 'astro:content'
import FormattedDate from '../components/FormattedDate.astro'
import BaseLayout from '../layouts/base.astro'
import VmuDisplay from '../components/VmuDisplay.astro'
import Card from '../components/card/card.astro'
import CardHeader from '../components/card/card-header.astro'
import CardTitle from '../components/card/card-title.astro'
import CardContent from '../components/card/card-content.astro'
import CardFooter from '../components/card/card-footer.astro'
import Button from '../components/button.astro'

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
)
---

<BaseLayout>
	<div class="flex items-center gap-6">
		<div>
			<h1 class="font-pixel-grid pb-3 text-4xl lg:text-8xl">Analog Freak</h1>
			<h2 class="text-muted-foreground text-xl">
				Webzine about retro gaming and analog tech
			</h2>
		</div>
	</div>

	<div
		class="mt-16 flex flex-col items-stretch gap-5 sm:mt-32 sm:flex-row sm:items-start"
	>
		<div class="hidden min-w-30 sm:block">
			<ul class="flex flex-col gap-2">
				<li>
					<a href="/" class="font-pixel-grid flex gap-1 text-2xl">Home</a>
				</li>
				<li>
					<a href="/" class="font-pixel-grid flex gap-1 text-2xl">About</a>
				</li>
			</ul>
		</div>
		<Card class="flex-1">
			<CardHeader>
				<CardTitle>WRITING</CardTitle>
			</CardHeader>

			<div class="space-y-5 sm:space-y-6">
				<ul class="divide-border flex flex-col divide-y">
					{
						posts.map(post => (
							<li>
								<a
									href={`/blog/${post.id}/`}
									class="flex gap-1 px-4 py-3 hover:bg-[#F5F4F4] md:grid md:grid-cols-[1fr_100px] md:gap-4 dark:hover:bg-gray-200"
								>
									<div class="flex flex-col">
										<span>{post.data.title}</span>
										<span class="text-muted-foreground">
											{post.data.description}
										</span>
									</div>

									<FormattedDate
										date={post.data.pubDate}
										class="text-muted-foreground hidden text-right text-sm leading-6 md:block"
									/>
								</a>
							</li>
						))
					}
				</ul>
			</div>
			<CardFooter>
				<Button> See all posts </Button>
			</CardFooter>
		</Card>
		<Card>
			<CardHeader>
				<CardTitle>VMU</CardTitle>
			</CardHeader>
			<CardContent class="flex flex-col items-center">
				<VmuDisplay dot={4} />
			</CardContent>
		</Card>
	</div>
</BaseLayout>
