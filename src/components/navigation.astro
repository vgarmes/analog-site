---
import Card from '../components/ui/card/card.astro'
import CardHeader from './ui/card/card-header.astro'
import CardTitle from './ui/card/card-title.astro'
---

<Card class="min-w-50">
	<CardHeader>
		<CardTitle>Navigation</CardTitle>
	</CardHeader>
	<nav>
		<ul class="flex flex-col gap-2 p-2">
			<li>
				<a
					href="/"
					class="bg-primary text-primary-foreground inline-flex h-8 w-full shrink-0 items-center justify-center gap-1.5 border px-2.5 text-sm font-medium whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0"
					>Home</a
				>
			</li>
			<li>
				<a
					href="/"
					class="bg-primary text-primary-foreground inline-flex h-8 w-full shrink-0 items-center justify-center gap-1.5 border px-2.5 text-sm font-medium whitespace-nowrap transition-all outline-none select-none disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:shrink-0"
					>About</a
				>
			</li>
		</ul>
	</nav>
</Card>
