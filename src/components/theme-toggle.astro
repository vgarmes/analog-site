---
const themes = ['auto', 'light', 'dark'] as const
---

<div
	id="themeToggle"
	class="flex gap-1 text-sm"
	role="group"
	aria-label="Theme"
>
	{
		themes.map(theme => (
			<button
				type="button"
				data-theme={theme}
				class="theme-option text-muted-foreground hover:text-foreground border-primary hover:bg-primary hover:text-primary-foreground cursor-pointer px-2 uppercase aria-pressed:border"
			>
				{theme}
			</button>
		))
	}
</div>

<script is:inline>
	const applyTheme = theme => {
		const isDark =
			theme === 'dark' ||
			(theme === 'auto' &&
				window.matchMedia('(prefers-color-scheme: dark)').matches)
		document.documentElement.classList.toggle('dark', isDark)
	}

	const getTheme = () => localStorage.getItem('theme') ?? 'auto'

	const setActive = theme => {
		document.querySelectorAll('.theme-option').forEach(button => {
			button.setAttribute(
				'aria-pressed',
				button.dataset.theme === theme ? 'true' : 'false'
			)
		})
	}

	setActive(getTheme())

	document.querySelectorAll('.theme-option').forEach(button => {
		button.addEventListener('click', () => {
			const theme = button.dataset.theme
			localStorage.setItem('theme', theme)
			applyTheme(theme)
			setActive(theme)
		})
	})

	// Follow the system when in "auto" mode.
	window
		.matchMedia('(prefers-color-scheme: dark)')
		.addEventListener('change', () => {
			if (getTheme() === 'auto') applyTheme('auto')
		})
</script>
