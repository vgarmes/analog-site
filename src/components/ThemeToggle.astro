---
const themes = ['auto', 'light', 'dark'] as const
---

<div id="themeToggle" class="flex gap-2 text-sm" role="group" aria-label="Theme">
	{
		themes.map((theme) => (
			<button
				type="button"
				data-theme={theme}
				class="theme-option cursor-pointer uppercase opacity-50 transition-opacity hover:opacity-100"
			>
				{theme}
			</button>
		))
	}
</div>

<style>
	.theme-option[aria-pressed='true'] {
		opacity: 1;
		text-decoration: underline;
	}
</style>

<script is:inline>
	const applyTheme = (theme) => {
		const isDark =
			theme === 'dark' ||
			(theme === 'auto' &&
				window.matchMedia('(prefers-color-scheme: dark)').matches)
		document.documentElement.classList.toggle('dark', isDark)
	}

	const getTheme = () => localStorage.getItem('theme') ?? 'auto'

	const setActive = (theme) => {
		document.querySelectorAll('.theme-option').forEach((button) => {
			button.setAttribute(
				'aria-pressed',
				button.dataset.theme === theme ? 'true' : 'false'
			)
		})
	}

	setActive(getTheme())

	document.querySelectorAll('.theme-option').forEach((button) => {
		button.addEventListener('click', () => {
			const theme = button.dataset.theme
			localStorage.setItem('theme', theme)
			applyTheme(theme)
			setActive(theme)
		})
	})

	// Follow the system when in "auto" mode.
	window
		.matchMedia('(prefers-color-scheme: dark)')
		.addEventListener('change', () => {
			if (getTheme() === 'auto') applyTheme('auto')
		})
</script>
